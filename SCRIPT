	end
	make("TextLabel", { Position = UDim2.fromOffset(0, 162), Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT_MED, RichText = true, Text = 'UI: <font color="#E2202A">Standard</font>  |  Executor: <font color="#E2202A">' .. execName .. "</font>", TextColor3 = DIM, TextSize = 11 }, win)

	-- key box
	local boxFrame = make("Frame", { Position = UDim2.fromOffset(16, 188), Size = UDim2.new(1, -32, 0, 34), BackgroundColor3 = PANEL, BorderSizePixel = 0 }, win)
	stroke(boxFrame, DRED, 0, 1)
