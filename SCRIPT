	-- close (top left) and gear (top right)
	local keyClose = make("TextButton", { Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, AutoButtonColor = false, Font = FONT_BOLD, Text = "X", TextColor3 = DIM, TextSize = 14, ZIndex = 3 }, win)
	keyClose.MouseEnter:Connect(function() tween(keyClose, { TextColor3 = RED }) end)
	keyClose.MouseLeave:Connect(function() tween(keyClose, { TextColor3 = DIM }) end)
	local gear = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, AutoButtonColor = false, Font = FONT_BOLD, Text = "⚙", TextColor3 = RED, TextSize = 22, ZIndex = 3 }, win)

	makeEye(win, RED, UDim2.new(0.5, 0, 0, 26), Vector2.new(0.5, 0))

	-- game table (just one game)
	local tbl = make("Frame", { Position = UDim2.fromOffset(16, 108), Size = UDim2.new(1, -32, 0, 46), BackgroundColor3 = PANEL, BorderSizePixel = 0 }, win)
