local KEYS = {
	{ key = "Vysxen", expires = "Lifetime" },   -- change these to your real keys
	{ key = "Tester", expires = "2080-12-31" }, -- for testing
}
local GET_KEY_LINK = "https://your-key-link-here" -- put your real key link here
local KEY_FILE = "SniperArenaKey.txt"
local GAME_NAME, GAME_SHORT = "Sniper Arena", "SA"

