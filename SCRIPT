	local bg = gradient(topbar, THEME.dark, THEME.accent, 0)
	bg.Transparency = NumberSequence.new(0, 0.45)
	for i = 1, 8 do
		make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.42 + i * 0.07, 0, 0.5, 0), Size = UDim2.fromOffset(i % 2 == 0 and 3 or 9, 170), Rotation = 28, BackgroundColor3 = THEME.accent2, BackgroundTransparency = 0.78 + (i % 3) * 0.05, BorderSizePixel = 0 }, topbar)
	end
	makeEye(topbar, THEME.accent, UDim2.fromOffset(10, 22), Vector2.new(0, 0), 0.62)
	make("TextLabel", { Position = UDim2.fromOffset(112, 14), Size = UDim2.new(1, -280, 0, 30), BackgroundTransparency = 1, Font = FONT_BOLD, RichText = true, Text = first:lower() .. '<font color="#FF5A62">.' .. second:lower() .. "</font>", TextColor3 = THEME.text, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Left }, topbar)
	make("TextLabel", { Position = UDim2.fromOffset(112, 46), Size = UDim2.new(1, -280, 0, 14), BackgroundTransparency = 1, Font = FONT, Text = "Cheat Client", TextColor3 = THEME.muted, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left }, topbar)

	local function controlButton(text, xOffset)
		local b = make("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0, 18), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = THEME.dark, BackgroundTransparency = 0.3, AutoButtonColor = false, Font = FONT_BOLD, Text = text, TextColor3 = THEME.muted, TextSize = 12, ZIndex = 2 }, topbar)
		round(b, 4)
		stroke(b, THEME.accent, 0.4, 1)
		b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = THEME.accent, TextColor3 = THEME.text }) end)
		b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = THEME.dark, TextColor3 = THEME.muted }) end)
		return b
	end
	local closeBtn = controlButton("X", -10)
	local hideBtn = controlButton("–", -38)
	local gearBtn = controlButton("⚙", -66)

	make("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, 56), Size = UDim2.fromOffset(150, 16), BackgroundTransparency = 1, Font = FONT_BOLD, Text = LocalPlayer.Name, TextColor3 = THEME.text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd }, topbar)
	local fpsLabel = make("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, 72), Size = UDim2.fromOffset(150, 14), BackgroundTransparency = 1, Font = FONT_MED, Text = "-- FPS", TextColor3 = THEME.muted, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right }, topbar)
	do
		local frames, last = 0, os.clock()
		track(RunService.RenderStepped:Connect(function()
			frames += 1
			local now = os.clock()
			if now - last >= 0.5 then
				fpsLabel.Text = math.floor(frames / (now - last) + 0.5) .. " FPS"
				frames, last = 0, now
			end
		end))
	end
	make("Frame", { Position = UDim2.fromOffset(0, TOPBAR_H), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = THEME.accent, BackgroundTransparency = 0.2, BorderSizePixel = 0 }, main)

	-- body
	local body = make("Frame", { Position = UDim2.fromOffset(0, TOPBAR_H + 1), Size = UDim2.new(1, 0, 1, -(TOPBAR_H + 1 + FOOTER_H)), BackgroundTransparency = 1 }, main)
	local tabList = make("Frame", { Size = UDim2.new(1, 0, 0, TAB_H), BackgroundTransparency = 1 }, body)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, tabList)
	make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, tabList)
	local pages = make("Frame", { Position = UDim2.fromOffset(0, TAB_H), Size = UDim2.new(1, 0, 1, -TAB_H), BackgroundTransparency = 1 }, body)

	-- footer
	local footer = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, FOOTER_H), BackgroundColor3 = THEME.deep, BorderSizePixel = 0 }, main)
	make("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = THEME.accent, BackgroundTransparency = 0.4, BorderSizePixel = 0 }, footer)
	make("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.5, -12, 1, 0), BackgroundTransparency = 1, Font = FONT_MED, RichText = true, Text = 'Version: <font color="#FF5A62">' .. (version or "0.0.1") .. '</font>      Expiry: <font color="#FF5A62">' .. keyExpiry .. "</font>", TextColor3 = THEME.muted, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left }, footer)
	UI.FooterHint = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.new(0.5, -12, 1, 0), BackgroundTransparency = 1, Font = FONT, Text = "RightShift  to hide / show", TextColor3 = THEME.muted, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right }, footer)

	-- toasts
	UI._toastOrder = 0
	UI._toasts = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(300, 300), BackgroundTransparency = 1, ZIndex = 50 }, gui)
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, UI._toasts)

	-- window drag (toggle in Settings > Menu)
	do
		local dragging, dragStart, startPos
		track(topbar.InputBegan:Connect(function(i)
			if UI.draggable and isPress(i) then dragging, dragStart, startPos = true, i.Position, holder.Position end
		end))
		track(UIS.InputChanged:Connect(function(i)
			if dragging and UI.draggable and isMove(i) then
				local d = i.Position - dragStart
				holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end))
		track(UIS.InputEnded:Connect(function(i) if isPress(i) then dragging = false end end))
	end

	-- floating eye bubble
	local EYE_RED = Color3.fromRGB(255, 45, 58)
	local bubble = make("TextButton", { Name = "Bubble", Position = UDim2.fromOffset(20, 90), Size = UDim2.fromOffset(52, 52), BackgroundColor3 = Color3.fromRGB(24, 5, 8), AutoButtonColor = false, Text = "", Visible = false, Active = true }, gui)
	round(bubble, 26)
	local bubbleStroke = stroke(bubble, EYE_RED, 0.18, 2)
	makeEye(bubble, EYE_RED, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), 0.30)
	task.spawn(function()
		while bubble.Parent do
			tween(bubbleStroke, { Transparency = 0.05, Thickness = 3 }, 0.75, Enum.EasingStyle.Sine)
			task.wait(0.75)
			if not bubble.Parent then break end
			tween(bubbleStroke, { Transparency = 0.45, Thickness = 2 }, 0.9, Enum.EasingStyle.Sine)
			task.wait(0.9)
		end
	end)

	local visible, busy = true, false
	local function setVisible(state, showBubble)
		if state == visible or busy then return end
		visible = state
		busy = true
		if state then
			bubble.Visible = false
			scale.Scale = 0.92
			holder.Visible = true
			tween(scale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
			task.delay(0.28, function() busy = false end)
		else
			tween(scale, { Scale = 0.92 }, 0.15)
			task.delay(0.15, function()
				holder.Visible = false
				bubble.Visible = showBubble == true
				busy = false
			end)
		end
	end
	hideBtn.MouseButton1Click:Connect(function() setVisible(false, true) end)
	closeBtn.MouseButton1Click:Connect(function() UI:Unload() end)

	do
		local dragging, moved, dragStart, startPos = false, false, nil, nil
		bubble.InputBegan:Connect(function(i)
			if isPress(i) then dragging, moved = true, false; dragStart, startPos = i.Position, bubble.Position end
		end)
		track(UIS.InputChanged:Connect(function(i)
			if dragging and isMove(i) then
				local d = i.Position - dragStart
				if d.Magnitude > 5 then moved = true end
				if moved then bubble.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end
			end
		end))
		track(UIS.InputEnded:Connect(function(i)
			if dragging and isPress(i) then
				dragging = false
				if not moved then setVisible(true) end
			end
		end))
	end

	track(UIS.InputBegan:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.Keyboard or UIS:GetFocusedTextBox() then return end
		local k = UI.Options.MenuKeybind
		if k and k.Listening then return end
		if i.KeyCode == (k and k.Value or Enum.KeyCode.RightShift) then setVisible(not visible, false) end
	end))

	scale.Scale = 0.92
	tween(scale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)

	-- tabs
	local Window = { _tabs = {} }
	local currentTab, lastRegular

	local function selectTab(entry)
		if currentTab == entry then return end
		for _, t in ipairs(Window._tabs) do
			local on = (t == entry)
			t.page.Visible = on
			tween(t.btn, { BackgroundColor3 = on and THEME.accent or THEME.panel }, 0.12)
			tween(t.edge, { Color = on and THEME.accent2 or THEME.edge }, 0.12)
			tween(t.txt, { TextColor3 = on and THEME.text or THEME.muted }, 0.12)
		end
		currentTab = entry
	end

	function Window:AddTab(name, hidden)
		local btn = make("TextButton", { Size = UDim2.fromOffset(hidden and 0 or 96, 24), BackgroundColor3 = THEME.panel, AutoButtonColor = false, Text = "", LayoutOrder = #Window._tabs + 1, Visible = not hidden }, tabList)
		round(btn, 4)
		local edge = stroke(btn, THEME.edge, 0, 1)
		local txt = label(btn, name, { Font = FONT_BOLD, TextColor3 = THEME.muted, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2 })

		local page = make("ScrollingFrame", { Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = THEME.accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false }, pages)
		local content = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, page)
		make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, content)
		make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 14) }, content)

		local tab = {}
		local subs, bar = {}, nil

		local function selectSub(s)
			for _, o in ipairs(subs) do
				local on = (o == s)
				o.card.Visible = on
				tween(o.btn, { BackgroundColor3 = on and THEME.accent or THEME.panel }, 0.12)
				tween(o.edge, { Color = on and THEME.accent2 or THEME.edge }, 0.12)
				tween(o.txt, { TextColor3 = on and THEME.text or THEME.muted }, 0.12)
			end
		end

		-- boxed sub-tab button + its own card of rows
		function tab:AddSubTab(subName, width)
			if not bar then
				bar = make("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = 1 }, content)
				make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }, bar)
			end
			local sb = make("TextButton", { Size = UDim2.fromOffset(width or 80, 24), BackgroundColor3 = THEME.panel, AutoButtonColor = false, Text = "", LayoutOrder = #subs + 1 }, bar)
			round(sb, 4)
			local se = stroke(sb, THEME.edge, 0, 1)
			local st = label(sb, subName, { Font = FONT_BOLD, TextColor3 = THEME.muted, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2 })

			local card = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2 }, content)
			make("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingTop = UDim.new(0, 2) }, card)
			make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, card)

			local s = { btn = sb, edge = se, txt = st, card = card }
			table.insert(subs, s)
			sb.MouseButton1Click:Connect(function() selectSub(s) end)
			if #subs == 1 then selectSub(s) else card.Visible = false end
			return setmetatable({ Frame = card, n = 0 }, Group)
		end

		local entry = { btn = btn, txt = txt, edge = edge, page = page }
		table.insert(Window._tabs, entry)
		btn.MouseEnter:Connect(function() if currentTab ~= entry then tween(txt, { TextColor3 = THEME.text }) end end)
		btn.MouseLeave:Connect(function() if currentTab ~= entry then tween(txt, { TextColor3 = THEME.muted }) end end)
		btn.MouseButton1Click:Connect(function() selectTab(entry) end)
		if hidden then Window._settingsEntry = entry end
		if #Window._tabs == 1 then selectTab(entry); lastRegular = entry end
		return tab
	end

	-- gear button toggles the (hidden) settings tab
	gearBtn.MouseButton1Click:Connect(function()
		local se = Window._settingsEntry
		if not se then return end
		if currentTab == se then
			selectTab(lastRegular or Window._tabs[1])
		else
			if currentTab then lastRegular = currentTab end
			selectTab(se)
		end
	end)

	Window.SetVisible = setVisible
	return Window
end

