		make("UIListLayout", { Padding = UDim.new(0, 3) }, list)

		local items = {}
		for _, v in ipairs(obj.Values) do
			local selected = (v == obj.Value)
			local it = make("TextButton", { Size = UDim2.new(1, -6, 0, 24), BackgroundColor3 = THEME.accent, BackgroundTransparency = selected and 0 or 1, Text = "", AutoButtonColor = false }, list)
			round(it, 3)
			local itLbl = label(it, tostring(v), { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), TextColor3 = selected and THEME.text or THEME.muted, ZIndex = 2 })
			it.MouseEnter:Connect(function() if not selected then it.BackgroundTransparency = 0.7; itLbl.TextColor3 = THEME.text end end)
			it.MouseLeave:Connect(function() if not selected then it.BackgroundTransparency = 1; itLbl.TextColor3 = THEME.muted end end)
			it.MouseButton1Click:Connect(function() obj:SetValue(v); close() end)
			items[#items + 1] = { btn = it, text = tostring(v):lower() }
		end
		search:GetPropertyChangedSignal("Text"):Connect(function()
			local q = search.Text:lower()
			for _, item in ipairs(items) do item.btn.Visible = q == "" or item.text:find(q, 1, true) ~= nil end
		end)
	end)
	UI.Options[id] = obj
	return obj
end

