local function track(c) table.insert(UI._conns, c); return c end

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) return make("UICorner", { CornerRadius = UDim.new(0, r or 4) }, o) end
local function gradient(o, c1, c2, rot)
	return make("UIGradient", { Color = ColorSequence.new(c1 or THEME.accent, c2 or THEME.accent2), Rotation = rot or 0 }, o)
end
local function stroke(o, color, transparency, thickness)
	return make("UIStroke", { Color = color or THEME.text, Transparency = transparency or 0.85, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function label(parent, text, props)
	local p = { BackgroundTransparency = 1, Text = text or "", Font = FONT, TextSize = 12, TextColor3 = THEME.text, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd }
	for k, v in pairs(props or {}) do p[k] = v end
	return make("TextLabel", p, parent)
end
local function tween(o, props, t, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function getGuiParent()
	local good, h = pcall(function() return gethui and gethui() end)
	if good and typeof(h) == "Instance" then return h end
	local ok2 = pcall(function() Instance.new("Folder", game:GetService("CoreGui")):Destroy() end)
	if ok2 then return game:GetService("CoreGui") end
	return LocalPlayer:WaitForChild("PlayerGui")
end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

