-- SKINS TAB
--====================================================================
local knifeBases = {"ButterflyKnife","ClassKnife","CordKnife","FlipKnife","GutKnife","OutDoorKnife","TacticalKnife","Karambit","Kukri","Wakizashi","CrookSword","Axe","Chainsaw","Shovel","Skeleton","RadishBlade","Lollipop","Trumpet","Bayonet_M9","BeamSaber","PrismTwins","ScalySawTeeth","Glove"}
local sniperBases = {"SSG","Kar98k","AWP","M82A1","M200","DSR1","NTW20","WA2000","Sniper1","Sniper2","Specter","Crossbow"}

local function isKnifeBase(base)
	for _, b in ipairs(knifeBases) do if base == b then return true end end
	return false
end

if WeaponConfig then
	local allBases = {}
	for k, v in pairs(WeaponConfig) do
		if type(k) == "string" and not k:find("%.") and type(v) == "table" and v.FirstPersonModel then allBases[k] = true end
	end

	local function getBaseKey(skinKey)
		if allBases[skinKey] then return skinKey end
		for segment in skinKey:gmatch("[^%.]+") do
			if allBases[segment] then return segment end
		end
		return skinKey:match("^([^%.]+)")
	end

	local goodSkins = { knives = {}, snipers = {} }
	for k, v in pairs(WeaponConfig) do
		if type(k) == "string" and type(v) == "table" then
			local sec = v.SecondaryRarity or ""
			if v.Rarity == "Mystic" and (sec == "Exotic" or sec == "Secret" or sec == "Souvenir") then
				local base = getBaseKey(k)
				if base and WeaponConfig[base] then
					local entry = { key = k, display = v.Display or k, base = base }
					if isKnifeBase(base) then
						table.insert(goodSkins.knives, entry)
					else
						for _, b in ipairs(sniperBases) do if base == b then table.insert(goodSkins.snipers, entry); break end end
					end
				end
			end
		end
	end
	table.sort(goodSkins.knives, function(a, b) return a.display < b.display end)
	table.sort(goodSkins.snipers, function(a, b) return a.display < b.display end)

	local backups = {}
	local function backupBase(baseKey)
		if backups[baseKey] then return end
		local base = WeaponConfig[baseKey]
		if not base then return end
		local b = { Display = base.Display, Image = base.Image, SoundGroup = base.SoundGroup, MeleeSeq = base.MeleeSeq, ControllerComponents = base.ControllerComponents }
		local parent = typeof(base.FirstPersonModel) == "Instance" and base.FirstPersonModel.Parent
		if parent then
			b.FP = parent:FindFirstChild("FirstPerson")
			b.TP = parent:FindFirstChild("ThirdPerson")
		end
		b.FakeArmAnims, b.CharacterAnims = {}, {}
		for n, a in pairs(base.FakeArmAnims or {}) do if typeof(a) == "Instance" then b.FakeArmAnims[n] = a end end
		for n, a in pairs(base.CharacterAnims or {}) do if typeof(a) == "Instance" then b.CharacterAnims[n] = a end end
		backups[baseKey] = b
	end

	local function resetBase(baseKey)
		local base, b = WeaponConfig[baseKey], backups[baseKey]
		if not base or not b then return end
		local parent = b.FP and b.FP.Parent
		if parent then
			local fp, tp = parent:FindFirstChild("FirstPerson"), parent:FindFirstChild("ThirdPerson")
			if fp and fp ~= b.FP then fp:Destroy() end
			if tp and tp ~= b.TP then tp:Destroy() end
			b.FP.Name = "FirstPerson"
			if b.TP then b.TP.Name = "ThirdPerson" end
		end
		base.FirstPersonModel = b.FP
		base.Display, base.Image, base.SoundGroup = b.Display, b.Image, b.SoundGroup
		base.MeleeSeq, base.ControllerComponents = b.MeleeSeq, b.ControllerComponents
		for n, a in pairs(b.FakeArmAnims) do base.FakeArmAnims[n] = a end
		for n, a in pairs(b.CharacterAnims) do base.CharacterAnims[n] = a end
		notify("Restored " .. baseKey)
	end

	-- swaps the models / anims of `exoticKey` onto `baseKey` (old swapped clones are destroyed, not piled up as _OLD)
	local function swapWeapon(baseKey, exoticKey)
		local base, exotic = WeaponConfig[baseKey], WeaponConfig[exoticKey]
		if not base or not exotic then return false end
		local baseFP, exoFP = base.FirstPersonModel, exotic.FirstPersonModel
		if typeof(baseFP) ~= "Instance" or typeof(exoFP) ~= "Instance" then return false end
		local baseParent, exoParent = baseFP.Parent, exoFP.Parent
		if not baseParent or not exoParent then return false end
		local bk = backups[baseKey]
		local newFP = exoParent:FindFirstChild("FirstPerson") or exoFP
		local newTP = exoParent:FindFirstChild("ThirdPerson")
		local oldFP, oldTP = baseParent:FindFirstChild("FirstPerson"), baseParent:FindFirstChild("ThirdPerson")

		local function retire(inst, oldName, newOne)
			if not inst or inst == newOne then return end
			if bk and (inst == bk.FP or inst == bk.TP) then inst.Name = oldName else inst:Destroy() end
		end
		retire(oldFP, "FirstPerson_OLD", newFP)
		retire(oldTP, "ThirdPerson_OLD", newTP)

		local clonedFP = newFP:Clone(); clonedFP.Name = "FirstPerson"; clonedFP.Parent = baseParent
		base.FirstPersonModel = clonedFP
		if newTP then local c = newTP:Clone(); c.Name = "ThirdPerson"; c.Parent = baseParent end

		for name, anim in pairs(exotic.FakeArmAnims or {}) do
			if typeof(anim) == "Instance" and base.FakeArmAnims then base.FakeArmAnims[name] = anim end
		end
		for name, anim in pairs(exotic.CharacterAnims or {}) do
			if typeof(anim) == "Instance" and base.CharacterAnims then base.CharacterAnims[name] = anim end
		end
		base.Display, base.Image = exotic.Display, exotic.Image
		if typeof(exotic.SoundGroup) == "Instance" then base.SoundGroup = exotic.SoundGroup:Clone() end
		if exotic.MeleeSeq then base.MeleeSeq = exotic.MeleeSeq end
		if exotic.ControllerComponents then base.ControllerComponents = exotic.ControllerComponents end
		return true
	end

	local function applySkin(skinKey)
		local baseKey = getBaseKey(skinKey)
		if not baseKey or not WeaponConfig[baseKey] or not WeaponConfig[skinKey] then return nil end
		if isKnifeBase(baseKey) then baseKey = "ClassKnife" end
		if not WeaponConfig[baseKey] then return nil end
		backupBase(baseKey)
		local good = pcall(function()
			if swapWeapon(baseKey, skinKey) then notify("Done, respawn to see the changes.") end
		end)
		if not good then notify("Couldn't apply that skin.") return nil end
		return baseKey
	end

	local function buildDropdown(group, name, skins, defaultText)
		local names = { defaultText }
		for _, s in ipairs(skins) do table.insert(names, s.display) end
		local touched = {} -- only the bases THIS dropdown changed get reset by its Default option
		group:AddLabel(#skins .. " " .. name:lower() .. " skins available")
		group:AddDropdown(name .. "_Dropdown", {
			Text = "Select " .. name .. " Skin",
			Searchable = true,
			Values = names,
			Default = defaultText,
			Callback = function(value)
				if not value or value == defaultText then
					for b in pairs(touched) do resetBase(b); touched[b] = nil end
					return
				end
				for _, s in ipairs(skins) do
					if s.display == value then
						local b = applySkin(s.key)
						if b then touched[b] = true end
						break
					end
				end
			end,
		})
	end

	buildDropdown(SkinsTab:AddSubTab("Knives", 80), "Knife", goodSkins.knives, "Default")
	buildDropdown(SkinsTab:AddSubTab("Snipers", 80), "Sniper", goodSkins.snipers, "Default")
else
	SkinsTab:AddSubTab("Skins", 80):AddLabel("WeaponConfig not found in this game.")
end

