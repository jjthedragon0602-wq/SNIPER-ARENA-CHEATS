	make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(9, 7.5), Size = UDim2.fromOffset(2, 9), Rotation = 45, BackgroundColor3 = THEME.text, BorderSizePixel = 0, ZIndex = 8 }, checkTick)
	make("TextLabel", { Position = UDim2.fromOffset(34, 8), Size = UDim2.fromOffset(130, 20), BackgroundTransparency = 1, Font = FONT_MED, Text = "Remember my key", TextColor3 = THEME.text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7 }, panel)
	check.MouseButton1Click:Connect(function()
		remember = not remember
		checkTick.Visible = remember
		check.BackgroundColor3 = remember and RED or THEME.deep
	end)
	local getKey = make("TextButton", { Position = UDim2.fromOffset(10, 38), Size = UDim2.fromOffset(156, 28), BackgroundColor3 = BTN, AutoButtonColor = false, Font = FONT_BOLD, Text = "Copy Key Link", TextColor3 = THEME.text, TextSize = 12, ZIndex = 7 }, panel)
	round(getKey, 3)
	stroke(getKey, DRED, 0, 1)
	getKey.MouseButton1Click:Connect(function()
		if typeof(setclipboard) == "function" then
			pcall(setclipboard, GET_KEY_LINK)
			say("Key link copied to clipboard", DIM)
		else
			say(GET_KEY_LINK, DIM)
		end
		panel.Visible = false
	end)
	gear.MouseButton1Click:Connect(function() panel.Visible = not panel.Visible end)

	-- saved key (only works if the executor has file functions)
	local function saveKey(text)
		if not canFile then return end
		pcall(function()
			if remember then
				writefile(KEY_FILE, (text:match("^%s*(.-)%s*$")))
			elseif isfile(KEY_FILE) and typeof(delfile) == "function" then
				delfile(KEY_FILE)
			end
		end)
	end
	if canFile then
		local ok4, saved = pcall(function() if isfile(KEY_FILE) then return readfile(KEY_FILE) end end)
		if ok4 and saved and saved ~= "" then box.Text = saved end
	end

	-- table row + button follow the key's state
	local verifiedInfo, checking = nil, false
	local function setRow(info)
		if info and not info.expired then
			statusLbl.Text, statusLbl.TextColor3 = "Active", THEME.green
			subLbl.Text, subLbl.TextColor3 = "Expiry: " .. info.label, THEME.green
		elseif info and info.expired then
			statusLbl.Text, statusLbl.TextColor3 = "Inactive", RED
			subLbl.Text, subLbl.TextColor3 = "Expired: " .. info.label, RED
		else
			statusLbl.Text, statusLbl.TextColor3 = "Inactive", RED
			subLbl.Text, subLbl.TextColor3 = "No Subscription", RED
		end
	end
	local function setButton(ready)
		btn.Text = ready and ("Load " .. GAME_NAME) or "Verify Key"
		tween(btn, { BackgroundColor3 = ready and Color3.fromRGB(150, 18, 28) or BTN }, 0.15)
		btn.TextColor3 = ready and THEME.text or Color3.fromRGB(200, 190, 190)
	end
	btn.MouseEnter:Connect(function() if not verifiedInfo then tween(btn, { BackgroundColor3 = Color3.fromRGB(86, 12, 20) }, 0.1) end end)
	btn.MouseLeave:Connect(function() if not verifiedInfo then tween(btn, { BackgroundColor3 = BTN }, 0.1) end end)

	local function verify()
		if checking or keyVerified then return end
		checking = true
		say("Checking your key...", DIM)
		btn.Text = "Checking..."
		task.wait(0.5)
		local info = findKey(box.Text)
		setRow(info)
		if info and not info.expired then
			verifiedInfo = info
			setButton(true)
			say("Key accepted. Expires: " .. info.label, THEME.green)
		else
			verifiedInfo = nil
			setButton(false)
			say(info and "That key has expired" or "Invalid key, try again", RED)
			for _, dx in ipairs({ 8, -8, 5, -5, 0 }) do
				win.Position = UDim2.new(0.5, dx, 0.5, 0)
				task.wait(0.04)
			end
		end
		checking = false
	end

	local function load()
		if not verifiedInfo or keyVerified then return end
		keyExpiry = verifiedInfo.label
		saveKey(box.Text)
		keyVerified = true
		say("Loading...", THEME.green)
		tween(keyScale, { Scale = 0.92 }, 0.2)
		task.wait(0.25)
		keyGui:Destroy()
	end

	btn.MouseButton1Click:Connect(function() if verifiedInfo then load() else verify() end end)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then if verifiedInfo then load() else verify() end end
	end)
	-- editing the key after it was accepted puts everything back to inactive
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if verifiedInfo and findKey(box.Text) == nil then
			verifiedInfo = nil
			setRow(nil)
			setButton(false)
			say("")
		end
	end)
	keyClose.MouseButton1Click:Connect(function()
		keyClosed = true
		keyGui:Destroy()
	end)

	tween(keyScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	-- a remembered key gets checked straight away so the table shows its date
	if box.Text ~= "" then task.spawn(verify) end
end

-- hold here until the key is right; closing the key window stops the script
while not keyVerified and not keyClosed do task.wait() end
if not keyVerified then return end

--====================================================================
-- ROWS (compact flat rows: control on the left, label on the right)
--====================================================================
local Group = {}
Group.__index = Group

function Group:_row(h)
	self.n += 1
	return make("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, LayoutOrder = self.n }, self.Frame)
end

function Group:AddLabel(text)
	local r = self:_row(16)
	return label(r, text, { TextColor3 = THEME.muted, TextSize = 11 })
end

function Group:AddDivider()
	local r = self:_row(1)
	make("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = THEME.edge, BackgroundTransparency = 0.4, BorderSizePixel = 0 }, r)
end

function Group:AddButton(opts)
	local r = self:_row(24)
	local b = make("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = THEME.accent, AutoButtonColor = false, Font = FONT_BOLD, Text = opts.Text, TextColor3 = THEME.text, TextSize = 12 }, r)
	round(b, 2)
	local armed = false
	b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = THEME.accent2 }, 0.1) end)
	b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = THEME.accent }, 0.1) end)
	b.MouseButton1Click:Connect(function()
		if opts.DoubleClick and not armed then
			armed = true
			b.Text = "Click again to confirm"
			task.delay(2, function() armed = false; if b.Parent then b.Text = opts.Text end end)
			return
		end
		armed = false
		b.Text = opts.Text
		if opts.Func then task.spawn(opts.Func) end
	end)
end

function Group:AddToggle(id, opts)
	local r = self:_row(24)
	local btn = make("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, r)
	local box = make("Frame", { Position = UDim2.fromOffset(0, 3), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = THEME.accent, BorderSizePixel = 0 }, btn)
	round(box, 2)
	stroke(box, THEME.accent, 0, 1)
	local tick = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, box)
	make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(6, 11), Size = UDim2.fromOffset(2, 5), Rotation = -45, BackgroundColor3 = THEME.text, BorderSizePixel = 0 }, tick)
	make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(10.5, 9), Size = UDim2.fromOffset(2, 10), Rotation = 45, BackgroundColor3 = THEME.text, BorderSizePixel = 0 }, tick)
	label(btn, opts.Text, { Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -28, 1, 0) })

	local obj = { Value = opts.Default and true or false, _cbs = {} }
	local function render(animate)
		tick.Visible = obj.Value
		local goal = obj.Value and THEME.accent or THEME.deep
		if animate then tween(box, { BackgroundColor3 = goal }, 0.12) else box.BackgroundColor3 = goal end
	end
	function obj:SetValue(v)
		self.Value = v and true or false
		render(true)
		if opts.Callback then task.spawn(opts.Callback, self.Value) end
		for _, f in ipairs(self._cbs) do task.spawn(f, self.Value) end
	end
	function obj:OnChanged(f) table.insert(self._cbs, f) end
	btn.MouseButton1Click:Connect(function()
		obj:SetValue(not obj.Value)
		UI:Notify(opts.Text .. (obj.Value and "  ON" or "  OFF"))
	end)
	render(false)
	UI.Toggles[id] = obj
	return obj
end

function Group:AddSlider(id, opts)
	local r = self:_row(24)
	local min, max = opts.Min or 0, opts.Max or 100
	local dec = opts.Rounding or 0
	local mult = 10 ^ dec
	local obj = { Value = opts.Default or min, _cbs = {} }
	local function fmt(v) return dec > 0 and string.format("%." .. dec .. "f", v) or tostring(math.floor(v + 0.5)) end

	local valBox = make("TextBox", { Position = UDim2.fromOffset(0, 1), Size = UDim2.fromOffset(46, 22), BackgroundColor3 = THEME.deep, BorderSizePixel = 0, ClearTextOnFocus = true, Font = FONT_BOLD, Text = fmt(obj.Value), TextColor3 = THEME.text, TextSize = 11 }, r)
	round(valBox, 2)
	stroke(valBox, THEME.accent, 0.35, 1)
	label(r, opts.Text, { Position = UDim2.new(CTRL_W, 6, 0, 0), Size = UDim2.new(1 - CTRL_W, -6, 1, 0) })

	local hit = make("TextButton", { Position = UDim2.fromOffset(52, 0), Size = UDim2.new(CTRL_W, -60, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, r)
	local bar = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = THEME.edge, BackgroundTransparency = 0.35, BorderSizePixel = 0 }, hit)
	round(bar, 2)
	local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.accent, BorderSizePixel = 0 }, bar)
	round(fill, 2)
	local knob = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(6, 16), BackgroundColor3 = THEME.text, BorderSizePixel = 0, ZIndex = 2 }, fill)
	round(knob, 2)

	local function render()
		fill.Size = UDim2.fromScale(math.clamp((obj.Value - min) / math.max(max - min, 1e-9), 0, 1), 1)
		valBox.Text = fmt(obj.Value)
	end
	function obj:SetValue(v)
		v = math.clamp(math.round(v * mult) / mult, min, max)
		if v == self.Value then render(); return end
		self.Value = v
		render()
		if opts.Callback then task.spawn(opts.Callback, v) end
		for _, f in ipairs(self._cbs) do task.spawn(f, v) end
	end
	function obj:OnChanged(f) table.insert(self._cbs, f) end

	local dragging = false
	local function fromX(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		obj:SetValue(min + (max - min) * a)
	end
	hit.InputBegan:Connect(function(i) if isPress(i) then dragging = true; fromX(i.Position.X) end end)
	track(UIS.InputChanged:Connect(function(i) if dragging and isMove(i) then fromX(i.Position.X) end end))
	track(UIS.InputEnded:Connect(function(i) if isPress(i) then dragging = false end end))
	valBox.FocusLost:Connect(function()
		local n = tonumber(valBox.Text:match("^%s*(-?%d*%.?%d+)"))
		if n then obj:SetValue(n) else render() end
	end)
	render()
	UI.Options[id] = obj
	return obj
end

