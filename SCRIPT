local canFile = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"

-- returns nil if the key doesn't exist, otherwise { label = ..., expired = true/false }
local function findKey(text)
	text = text:match("^%s*(.-)%s*$")
	for _, k in ipairs(KEYS) do
		if text == k.key then
			local info = { label = k.expires, expired = false }
			local y, m, d = tostring(k.expires):match("^(%d+)-(%d+)-(%d+)$")
			if y then
				local endOfDay = os.time({ year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 23, min = 59, sec = 59 })
				info.expired = os.time() > endOfDay
			end
			return info
		end
	end
	return nil
end

