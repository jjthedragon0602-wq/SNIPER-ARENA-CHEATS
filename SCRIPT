local silentPart -- the part currently being targeted (nil = no target)

--------------------------------------------------------------------
-- SILENT AIM HOOKS: redirect what the game's own shooting code asks for
--------------------------------------------------------------------
local hooksOn = true
local canHook = typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function"
	and typeof(checkcaller) == "function" and typeof(newcclosure) == "function"
local mouse = LocalPlayer:GetMouse()
local lastLog = {}

local function shouldRedirect()
	if not hooksOn or not silentPart or not silentPart.Parent then return false end
	if not tog("SA_Enabled") then return false end
	local chance = val("SA_HitChance") or 100
	return chance >= 100 or math.random(1, 100) <= chance
end

local function logShot(what)
	local now = os.clock()
	if lastLog[what] and now - lastLog[what] < 1 then return end
	lastLog[what] = now
	print("[SniperArena]", what)
end

if canHook then
	local hookOk, hookErr = pcall(function()
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			local method = getnamecallmethod() -- must be read first
			if hooksOn and not checkcaller() then
				local n = select("#", ...)
				if self == workspace and tog("SA_HookRay") then
					if method == "Raycast" then
						local args = { ... }
						local origin, dir = args[1], args[2]
						if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
							if tog("SA_LogShots") then logShot("workspace:Raycast dir=" .. math.floor(dir.Magnitude)) end
							if shouldRedirect() then
								args[2] = (silentPart.Position - origin).Unit * dir.Magnitude
								return oldNamecall(self, table.unpack(args, 1, n))
							end
						end
					elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
						local args = { ... }
						local ray = args[1]
						if typeof(ray) == "Ray" then
							if tog("SA_LogShots") then logShot("workspace:" .. method) end
							if shouldRedirect() then
								args[1] = Ray.new(ray.Origin, (silentPart.Position - ray.Origin).Unit * ray.Direction.Magnitude)
								return oldNamecall(self, table.unpack(args, 1, n))
							end
						end
					end
				end
				if self == Camera and tog("SA_HookMouse") and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
					local ray = oldNamecall(self, ...)
					if tog("SA_LogShots") then logShot("Camera:" .. method) end
					if typeof(ray) == "Ray" and shouldRedirect() then
						return Ray.new(ray.Origin, (silentPart.Position - ray.Origin).Unit)
					end
					return ray
				end
				if tog("SA_LogShots") and (method == "FireServer" or method == "InvokeServer") then
					local parts = {}
					for i, a in ipairs({ ... }) do parts[i] = typeof(a) .. ":" .. tostring(a) end
					logShot(tostring(self) .. ":" .. method .. "(" .. table.concat(parts, ", ") .. ")")
				end
			end
			return oldNamecall(self, ...)
		end))

		local oldIndex
		oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
			if hooksOn and self == mouse and (key == "Hit" or key == "Target") and not checkcaller() and tog("SA_HookMouse") then
				if tog("SA_LogShots") then logShot("Mouse." .. key) end
				if shouldRedirect() then
					if key == "Hit" then return CFrame.new(silentPart.Position) end
					return silentPart
				end
			end
			return oldIndex(self, key)
		end))
	end)
	saHookStatus.Text = hookOk and "Hooks: active" or "Hooks: failed to install (see console)"
	if not hookOk then warn("[SniperArena] hook error: " .. tostring(hookErr)) end
else
	saHookStatus.Text = "Hooks: your executor lacks hookmetamethod / checkcaller"
end
table.insert(UI._unload, function() hooksOn = false end)

-- closest player to the mouse (inside the FOV circle when "Limit Targets To FOV" is on)
local function GetClosestPlayer()
	local mousePos = UIS:GetMouseLocation()
	local useFov = tog("SA_UseFov")
	local best, bestDist, bestPart = nil, useFov and (val("SA_FovRadius") or 120) or math.huge, nil
	local partName = val("SA_Part") or "Head"

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local part = char and (char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart"))
			local skip = not (hum and part) or hum.Health <= 0
			if not skip and tog("SA_TeamCheck") and plr.Team ~= nil and plr.Team == LocalPlayer.Team then skip = true end
			if not skip then
				local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local d = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
					if d < bestDist and (not tog("SA_VisCheck") or isVisible(plr, char, part)) then
						best, bestDist, bestPart = plr, d, part
					end
				end
			end
		end
	end
	return best, bestPart
end

-- the position your gun system should aim at (nil when silent aim is off or nobody is in range)
local function GetSilentAimPosition()
	if not tog("SA_Enabled") then return nil end
	local _, part = GetClosestPlayer()
	return part and part.Position or nil
end
