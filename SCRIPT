	local status = make("TextLabel", { Position = UDim2.fromOffset(0, 226), Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT_MED, Text = "", TextColor3 = DIM, TextSize = 11 }, win)
	local function say(text, color) status.Text = text; status.TextColor3 = color or DIM end

	-- the big button: "Verify Key", then "Load Sniper Arena"
	local btn = make("TextButton", { Position = UDim2.fromOffset(16, 250), Size = UDim2.new(1, -32, 0, 46), BackgroundColor3 = BTN, AutoButtonColor = false, Font = FONT_BOLD, Text = "Verify Key", TextColor3 = Color3.fromRGB(200, 190, 190), TextSize = 14 }, win)
	round(btn, 3)
	stroke(btn, DRED, 0, 1)
	make("TextLabel", { Position = UDim2.new(0, 0, 1, -30), Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT, Text = "Version 0.0.2 BETA", TextColor3 = DIM, TextSize = 10 }, win)

	-- gear panel (remember key + copy key link)
	local remember = true
	local panel = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 38), Size = UDim2.fromOffset(176, 76), BackgroundColor3 = PANEL, BorderSizePixel = 0, Visible = false, ZIndex = 6 }, win)
