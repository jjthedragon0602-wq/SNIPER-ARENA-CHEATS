--====================================================================
local BLACK = Color3.new(0, 0, 0)
local R15 = {
	{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
	{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
	{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
	{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
	{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local R6 = {
	{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"},
}

local objs = {}
local visCache = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function makeObj()
	local o = { all = {}, hidden = true }
	local function add(class, props)
		local d = Drawing.new(class)
		d.Visible = false
		for k, v in pairs(props or {}) do d[k] = v end
		o.all[#o.all + 1] = d
		return d
	end
	local function text() return add("Text", { Center = true, Outline = true, OutlineColor = BLACK, Font = 2, Size = 13 }) end
	o.fill = add("Square", { Filled = true })
	o.boxOut = add("Square", { Filled = false, Color = BLACK, Transparency = 0.8 })
	o.box = add("Square", { Filled = false })
	o.cOut, o.c = {}, {}
	for i = 1, 8 do o.cOut[i] = add("Line", { Color = BLACK, Transparency = 0.8 }) end
	for i = 1, 8 do o.c[i] = add("Line") end
	o.hpBack = add("Square", { Filled = true, Color = BLACK, Transparency = 0.7 })
	o.hpFill = add("Square", { Filled = true })
	o.name, o.dist, o.tool, o.hpText = text(), text(), text(), text()
	o.skel = {}
	for i = 1, 14 do o.skel[i] = add("Line") end
	o.head = add("Circle", { Filled = false, NumSides = 20 })
	o.tracer = add("Line")
	return o
end

local function hideDrawings(o)
	if o.hidden then return end
	o.hidden = true
	for _, d in ipairs(o.all) do d.Visible = false end
end
local function clearCham(o)
	if o.hl then pcall(function() o.hl:Destroy() end); o.hl = nil end
end
local function destroyObj(plr)
	local o = objs[plr]
	if o then
		clearCham(o)
		for _, d in ipairs(o.all) do pcall(function() d:Remove() end) end
		objs[plr] = nil
	end
	visCache[plr] = nil
end

local function isVisible(plr, char, head)
	local now = os.clock()
	local c = visCache[plr]
	if c and now - c.t < 0.1 then return c.v end
	rayParams.FilterDescendantsInstances = { LocalPlayer.Character, char }
	local origin = Camera.CFrame.Position
	local v = workspace:Raycast(origin, head.Position - origin, rayParams) == nil
	if c then c.t, c.v = now, v else visCache[plr] = { t = now, v = v } end
	return v
end

local function healthColor(p) return Color3.fromRGB(226, 32, 42):Lerp(Color3.fromRGB(72, 220, 70), math.clamp(p, 0, 1)) end

local function drawPlayer(plr, o, S)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if not (hum and root and head) or hum.Health <= 0 then hideDrawings(o); clearCham(o); return end
	if S.teamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then hideDrawings(o); clearCham(o); return end

	local camPos = Camera.CFrame.Position
	local dist = (root.Position - camPos).Magnitude
	if S.maxDist > 0 and dist > S.maxDist then hideDrawings(o); clearCham(o); return end

	-- colours
	local boxCol, skelCol, tracerCol = S.boxCol, S.skelCol, S.tracerCol
	if S.teamColors and plr.Team then boxCol = plr.Team.TeamColor.Color end
	if S.visCheck then
		local c = isVisible(plr, char, head) and S.visCol or S.hidCol
		boxCol, skelCol, tracerCol = c, c, c
	end

	-- chams
	if S.chams then
		if not o.hl or o.hl.Parent ~= char then
			clearCham(o)
			o.hl = Instance.new("Highlight")
			o.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			o.hl.Parent = char
		end
		o.hl.FillColor = boxCol
		o.hl.OutlineColor = S.textCol
		o.hl.FillTransparency = 0.55
		o.hl.OutlineTransparency = 0.1
	else
		clearCham(o)
	end

	local rootV = Camera:WorldToViewportPoint(root.Position)
	if rootV.Z <= 0 then hideDrawings(o); return end
	local topV = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y / 2 + 0.25, 0))
	local botOff = hum.RigType == Enum.HumanoidRigType.R6 and 3 or (hum.HipHeight + root.Size.Y / 2)
	local botV = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, botOff, 0))

	local top, bottom = math.min(topV.Y, botV.Y), math.max(topV.Y, botV.Y)
	local h = bottom - top
	if h < 4 then hideDrawings(o); return end
	local w = h * 0.55
	local x = rootV.X
	local left, right = x - w / 2, x + w / 2

	o.hidden = false
	local th = S.thickness
	local ts = S.textSize

	-- box
	local full = S.box and S.boxStyle == "Full"
	local corner = S.box and S.boxStyle == "Corner"
	o.box.Visible, o.boxOut.Visible = full, full
	if full then
		o.boxOut.Position, o.boxOut.Size, o.boxOut.Thickness = Vector2.new(left, top), Vector2.new(w, h), th + 2
		o.box.Position, o.box.Size, o.box.Thickness, o.box.Color = Vector2.new(left, top), Vector2.new(w, h), th, boxCol
	end
	for i = 1, 8 do o.c[i].Visible = false; o.cOut[i].Visible = false end
	if corner then
		local cw, ch = w * 0.25, h * 0.25
		local segs = {
			{ Vector2.new(left, top), Vector2.new(left + cw, top) },
			{ Vector2.new(left, top), Vector2.new(left, top + ch) },
			{ Vector2.new(right, top), Vector2.new(right - cw, top) },
			{ Vector2.new(right, top), Vector2.new(right, top + ch) },
			{ Vector2.new(right, bottom), Vector2.new(right - cw, bottom) },
			{ Vector2.new(right, bottom), Vector2.new(right, bottom - ch) },
			{ Vector2.new(left, bottom), Vector2.new(left + cw, bottom) },
			{ Vector2.new(left, bottom), Vector2.new(left, bottom - ch) },
		}
		for i, s in ipairs(segs) do
			local ol, l = o.cOut[i], o.c[i]
			ol.From, ol.To, ol.Thickness, ol.Visible = s[1], s[2], th + 2, true
			l.From, l.To, l.Thickness, l.Color, l.Visible = s[1], s[2], th, boxCol, true
		end
	end
	local fillOn = S.box and S.fill
	o.fill.Visible = fillOn
	if fillOn then
		o.fill.Position, o.fill.Size, o.fill.Color, o.fill.Transparency = Vector2.new(left, top), Vector2.new(w, h), boxCol, S.fillOpacity
	end

	-- health bar (left side)
	local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
	local hpOn = S.health
	o.hpBack.Visible, o.hpFill.Visible = hpOn, hpOn
	local hh = h * pct
	if hpOn then
		o.hpBack.Position, o.hpBack.Size = Vector2.new(left - 7, top - 1), Vector2.new(5, h + 2)
		o.hpFill.Position, o.hpFill.Size, o.hpFill.Color = Vector2.new(left - 6, bottom - hh), Vector2.new(3, hh), healthColor(pct)
	end
	local ht = S.healthText
	o.hpText.Visible = ht
	if ht then
		o.hpText.Text = tostring(math.floor(hum.Health + 0.5))
		o.hpText.Size, o.hpText.Color = math.max(ts - 3, 9), healthColor(pct)
		o.hpText.Position = Vector2.new(left - 20, math.clamp(bottom - hh - 6, top - 6, bottom - 6))
	end

	-- name above, distance + tool below
	o.name.Visible = S.name
	if S.name then
		o.name.Text = plr.DisplayName ~= plr.Name and plr.DisplayName or plr.Name
		o.name.Size, o.name.Color = ts, S.textCol
		o.name.Position = Vector2.new(x, top - ts - 4)
	end
	local yOff = bottom + 2
	o.dist.Visible = S.distance
	if S.distance then
		o.dist.Text = string.format("[%d studs]", math.floor(dist + 0.5))
		o.dist.Size, o.dist.Color = ts - 1, S.textCol
		o.dist.Position = Vector2.new(x, yOff)
		yOff += ts + 1
	end
	local tool = S.tool and char:FindFirstChildOfClass("Tool")
	o.tool.Visible = tool ~= nil and tool ~= false
	if tool then
		o.tool.Text = tool.Name
		o.tool.Size, o.tool.Color = ts - 1, S.muted
		o.tool.Position = Vector2.new(x, yOff)
	end

	-- skeleton
	local conns = (hum.RigType == Enum.HumanoidRigType.R6) and R6 or R15
	for i = 1, 14 do
		local l = o.skel[i]
		local pair = S.skeleton and conns[i]
		local drawn = false
		if pair then
			local p1, p2 = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
			if p1 and p2 then
				local a, b = Camera:WorldToViewportPoint(p1.Position), Camera:WorldToViewportPoint(p2.Position)
				if a.Z > 0 and b.Z > 0 then
					l.From, l.To = Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y)
					l.Color, l.Thickness = skelCol, S.skelThickness
					drawn = true
				end
			end
		end
		l.Visible = drawn
	end

	-- head dot
	o.head.Visible = false
	if S.headDot then
		local hv = Camera:WorldToViewportPoint(head.Position)
		if hv.Z > 0 then
			o.head.Position, o.head.Radius, o.head.Color, o.head.Thickness = Vector2.new(hv.X, hv.Y), math.max(h * 0.08, 2), skelCol, 1
			o.head.Visible = true
		end
	end

	-- tracer
	o.tracer.Visible = S.tracers
	if S.tracers then
		local vs = Camera.ViewportSize
		local origin
		if S.tracerOrigin == "Center" then origin = Vector2.new(vs.X / 2, vs.Y / 2)
		elseif S.tracerOrigin == "Top" then origin = Vector2.new(vs.X / 2, 0)
		elseif S.tracerOrigin == "Mouse" then origin = UIS:GetMouseLocation()
		else origin = Vector2.new(vs.X / 2, vs.Y) end
		o.tracer.From, o.tracer.To, o.tracer.Color, o.tracer.Thickness = origin, Vector2.new(x, bottom), tracerCol, 1
	end
end

