--====================================================================
-- NOTIFICATIONS (top-centre toasts, same as the hub)
--====================================================================
function UI:Notify(text)
	if not self.notifications or not self._toasts then return end
	self._toastOrder += 1
	local t = make("Frame", { Size = UDim2.fromOffset(250, 30), BackgroundColor3 = THEME.dark, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = self._toastOrder }, self._toasts)
	round(t, 4)
	local st = stroke(t, THEME.accent, 1, 1)
	local lbl = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = FONT_BOLD, Text = text, TextColor3 = THEME.text, TextTransparency = 1, TextSize = 12 }, t)
	tween(t, { BackgroundTransparency = 0.05 }, 0.2)
	tween(st, { Transparency = 0.1 }, 0.2)
	tween(lbl, { TextTransparency = 0 }, 0.2)
	task.delay(2.2, function()
		tween(t, { BackgroundTransparency = 1 }, 0.3)
		tween(st, { Transparency = 1 }, 0.3)
		tween(lbl, { TextTransparency = 1 }, 0.3)
		task.delay(0.35, function() t:Destroy() end)
	end)
end

function UI:Unload()
	for _, f in ipairs(self._unload) do pcall(f) end
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	if self.Gui then self.Gui:Destroy() end
end

