-- CONFIGS
--====================================================================
local CONFIG_DIR = "SniperArenaConfigs"
local AUTOLOAD_PATH = CONFIG_DIR .. "/autoload.txt"
local hasFS = typeof(writefile) == "function" and typeof(readfile) == "function"
	and typeof(isfile) == "function" and typeof(isfolder) == "function"
	and typeof(makefolder) == "function" and typeof(listfiles) == "function"

local ConfigGroup = SettingsTab:AddSubTab("Configs", 70)

if not hasFS then
	ConfigGroup:AddLabel("Your executor has no file functions.")
else
	if not isfolder(CONFIG_DIR) then pcall(makefolder, CONFIG_DIR) end

	local function cleanName(n)
		n = tostring(n or ""):gsub("[^%w_%- ]", "")
		return (n:gsub("^%s+", ""):gsub("%s+$", ""))
	end
	local function pathOf(name) return CONFIG_DIR .. "/" .. name .. ".json" end

	local function listConfigs()
		local names = { "None" }
		local good, files = pcall(listfiles, CONFIG_DIR)
		if good and files then
			for _, f in ipairs(files) do
				local n = tostring(f):match("([^/\\]+)%.json$")
				if n then table.insert(names, n) end
			end
		end
		table.sort(names, function(a, b)
			if a == "None" then return true end
			if b == "None" then return false end
			return a:lower() < b:lower()
		end)
		return names
	end

	local function snapshot()
		local data = { Toggles = {}, Options = {} }
		for id, t in pairs(UI.Toggles) do data.Toggles[id] = t.Value end
		for id, o in pairs(UI.Options) do
			if not o.NoSave then
				local v = o.Value
				local tv = typeof(v)
				if tv == "Color3" then
					data.Options[id] = { type = "Color3", r = math.floor(v.R * 255 + 0.5), g = math.floor(v.G * 255 + 0.5), b = math.floor(v.B * 255 + 0.5) }
				elseif tv == "EnumItem" then
					data.Options[id] = { type = "KeyCode", name = v.Name }
				elseif tv == "number" or tv == "string" then
					data.Options[id] = v
				end
			end
		end
		return data
	end

	local function apply(data)
		for id, v in pairs(data.Toggles or {}) do
			local t = UI.Toggles[id]
			if t and type(v) == "boolean" then pcall(t.SetValue, t, v) end
		end
		for id, v in pairs(data.Options or {}) do
			local o = UI.Options[id]
			if o and o.SetValue and not o.NoSave then
				if type(v) == "table" then
					if v.type == "Color3" then pcall(o.SetValue, o, Color3.fromRGB(v.r, v.g, v.b))
					elseif v.type == "KeyCode" and Enum.KeyCode[v.name] then pcall(o.SetValue, o, Enum.KeyCode[v.name]) end
				else
					pcall(o.SetValue, o, v)
				end
			end
		end
	end

	local nameInput = ConfigGroup:AddInput("Config_Name", { Text = "Config name", Placeholder = "e.g. legit" })
	local listDrop = ConfigGroup:AddDropdown("Config_List", { Text = "Saved configs", Values = listConfigs(), Default = "None", Searchable = false })
	listDrop.NoSave = true

	local function refresh(select)
		listDrop:SetValues(listConfigs())
		listDrop.Value = select or "None"
		listDrop:SetValue(listDrop.Value)
	end
	local function pickName()
		local n = cleanName(nameInput.Value)
		if n ~= "" then return n end
		if listDrop.Value and listDrop.Value ~= "None" then return listDrop.Value end
		return nil
	end
	local function loadConfig(name)
		if not isfile(pathOf(name)) then notify("Config not found: " .. name); return false end
		local good, data = pcall(function() return HttpService:JSONDecode(readfile(pathOf(name))) end)
		if not good or type(data) ~= "table" then notify("Config is corrupted."); return false end
		apply(data)
		notify("Loaded config: " .. name)
		return true
	end

	ConfigGroup:AddButton({ Text = "Save Config", Func = function()
		local n = pickName()
		if not n then notify("Enter a config name first."); return end
		local good = pcall(function() writefile(pathOf(n), HttpService:JSONEncode(snapshot())) end)
		if good then notify("Saved config: " .. n); refresh(n) else notify("Save failed.") end
	end })
	ConfigGroup:AddButton({ Text = "Load Config", Func = function()
		local n = pickName()
		if not n then notify("Pick or type a config name."); return end
		loadConfig(n)
	end })
	ConfigGroup:AddButton({ Text = "Delete Config", DoubleClick = true, Func = function()
		local n = pickName()
		if not n then notify("Pick or type a config name."); return end
		if typeof(delfile) == "function" and isfile(pathOf(n)) then
			pcall(delfile, pathOf(n))
			notify("Deleted config: " .. n)
			refresh()
		else
			notify("Nothing to delete.")
		end
	end })
	ConfigGroup:AddButton({ Text = "Refresh List", Func = function() refresh(listDrop.Value) end })
	ConfigGroup:AddDivider()
	ConfigGroup:AddButton({ Text = "Set As Autoload", Func = function()
		local n = pickName()
		if not n or not isfile(pathOf(n)) then notify("Save the config first."); return end
		pcall(writefile, AUTOLOAD_PATH, n)
		notify("Autoload set: " .. n)
	end })
	ConfigGroup:AddButton({ Text = "Clear Autoload", Func = function()
		if typeof(delfile) == "function" and isfile(AUTOLOAD_PATH) then
			pcall(delfile, AUTOLOAD_PATH)
			notify("Autoload cleared.")
		else
			notify("No autoload set.")
		end
	end })

	task.defer(function()
		if isfile(AUTOLOAD_PATH) then
			local n = cleanName(readfile(AUTOLOAD_PATH))
			if n ~= "" and isfile(pathOf(n)) then
				if loadConfig(n) then refresh(n) end
			end
		end
	end)
end

